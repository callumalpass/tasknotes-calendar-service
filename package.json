{
  "name": "tasknotes-calendar-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:security": "vitest run test/security",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "migrations:local": "wrangler d1 migrations apply tasknotes-calendar-local --local",
    "migrations:lab:list": "wrangler d1 migrations list tasknotes-calendar-lab --remote --env lab",
    "migrations:lab": "wrangler d1 migrations apply tasknotes-calendar-lab --remote --env lab",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir dist/worker",
    "deploy:lab:dry-run": "wrangler deploy --env lab --dry-run --outdir dist/worker-lab",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:security && pnpm test:coverage && pnpm deploy:dry-run"
  },
  "dependencies": {
    "jose": "6.1.0",
    "zod": "4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260830.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
