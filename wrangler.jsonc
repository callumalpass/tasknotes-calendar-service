{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasknotes-calendar-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasknotes-calendar-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "GOOGLE_CLIENT_ID": "local-fake-google-client",
    "GOOGLE_AUTHORIZATION_ENDPOINT": "http://127.0.0.1:9797/authorize",
    "GOOGLE_TOKEN_ENDPOINT": "http://127.0.0.1:9797/token",
    "GOOGLE_JWKS_URI": "http://127.0.0.1:9797/jwks",
    "GOOGLE_ISSUER": "https://accounts.google.com",
    "GOOGLE_REVOCATION_ENDPOINT": "http://127.0.0.1:9797/revoke",
    "GOOGLE_CALENDAR_API_ORIGIN": "http://127.0.0.1:9797",
  },
  "env": {
    "lab": {
      "name": "tasknotes-calendar-lab",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false },
      },
      "triggers": { "crons": ["0 * * * *"] },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tasknotes-calendar-lab",
          "database_id": "eb83a4e6-2292-4c94-8d39-1618e84bbd3d",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "lab",
        "ALLOWED_ORIGINS": "",
        "PUBLIC_ORIGIN": "https://tasknotes-calendar-lab.callumalpass.workers.dev",
        "GOOGLE_CLIENT_ID": "1053661144223-a06h6u8uijtpnncoupo208qalse18a04.apps.googleusercontent.com",
        "GOOGLE_AUTHORIZATION_ENDPOINT": "https://accounts.google.com/o/oauth2/v2/auth",
        "GOOGLE_TOKEN_ENDPOINT": "https://oauth2.googleapis.com/token",
        "GOOGLE_JWKS_URI": "https://www.googleapis.com/oauth2/v3/certs",
        "GOOGLE_ISSUER": "https://accounts.google.com",
        "GOOGLE_REVOCATION_ENDPOINT": "https://oauth2.googleapis.com/revoke",
        "GOOGLE_CALENDAR_API_ORIGIN": "https://www.googleapis.com",
      },
    },
  },
}
